{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "noUpdateNotifier": true,
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "codegen": { "dependsOn": ["^codegen"], "inputs": ["$TURBO_DEFAULT$"] },
    "generate": { "dependsOn": ["^generate"], "inputs": ["$TURBO_DEFAULT$"] },
    "build": {
      "dependsOn": ["codegen", "^generate"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"]
    },
    "//#lang:extract": {
      "inputs": [
        "apps/{site,spa}/**/*.{ts,tsx,js,jsx}",
        "packages/**/*.{ts,tsx,js,jsx}",
        "packages/lang/package.json",
        "!**/{node_modules,out,.next,.open-next,.tmp,storybook-static,dist,.turbo}/**/*",
        "!packages/icons/{src,generated}/**/*",
        "!**/*.d.ts"
      ],
      "outputs": ["packages/lang/src/en.json"]
    },
    "lint": { "dependsOn": ["codegen"] },
    "test": { "dependsOn": ["check"] },
    "check": { "dependsOn": ["^check", "codegen"] },
    "storybook": {
      "dependsOn": ["codegen", "^generate"],
      "cache": false,
      "persistent": true,
      "interruptible": true
    },
    "dev": {
      "dependsOn": ["codegen", "^generate"],
      "cache": false,
      "persistent": true,
      "interruptible": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local"
      ],
      "env": ["ANALYZE", "BACKEND_URL"]
    },
    "spa#build": {
      "dependsOn": ["codegen", "^generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local"
      ],
      "env": ["ANALYZE", "APP_VERSION", "BACKEND_URL", "GITHUB_SHA"],
      "outputs": ["out/**", ".next/**", "!.next/cache/**"]
    },
    "site#build": {
      "dependsOn": ["codegen", "^generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local"
      ],
      "env": ["ANALYZE", "APP_VERSION", "BACKEND_URL", "GITHUB_SHA"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "legacy#build": {
      "dependsOn": ["codegen", "^generate"],
      "env": ["APP_VERSION", "GITHUB_SHA"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env",
        ".env.local",
        "$TURBO_ROOT$/.env",
        "$TURBO_ROOT$/.env.local"
      ],
      "outputs": ["dist/**"]
    },
    "boluo-storybook#build": {
      "dependsOn": ["codegen", "^generate"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["storybook-static/**"]
    },
    "@boluo/lang#generate": {
      "inputs": ["src/**/*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "@boluo/icons#codegen": {
      "inputs": ["icons/**", "scripts/**", "package.json"],
      "outputs": ["src/**", "generated/**"]
    },
    "@boluo/grafana#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    }
  }
}
