  "db_name": "PostgreSQL",
  "query": "SELECT\n    s AS \"space!: SpaceRecord\",\n    COALESCE(activity.latest_activity, s.created) AS \"latest_activity!\"\nFROM\n    spaces s\nLEFT JOIN space_activity activity ON activity.space_id = s.id\nWHERE\n    s.id = ANY($1)\n    AND deleted = FALSE;\n",
