  "query": "SELECT\n    operation_id,\n    operator_id,\n    scope_id,\n    entry_id,\n    source_message_id,\n    key,\n    previous_key,\n    action AS \"action!: EntryHistoryAction\",\n    created\nFROM entry_history\nWHERE scope_id = $1\n  AND ($2::uuid IS NULL OR entry_id = $2)\nORDER BY created DESC, operation_id DESC, entry_id;\n",
