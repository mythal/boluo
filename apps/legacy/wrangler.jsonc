{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "boluo-legacy",
  "compatibility_date": "2026-07-18",
  "main": "../../packages/backend-proxy/dist/worker.js",
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "version_metadata": {
    "binding": "WORKER_VERSION",
  },
  "r2_buckets": [
    {
      "binding": "HISTORY_FILES",
      "bucket_name": "boluo-history-files",
    },
  ],
  "vars": {
    "BACKEND_URL": "https://production.boluo.chat",
    "DEPLOYMENT_ENV": "production",
    "FRONTEND_APP": "legacy",
  },
  "env": {
    "production": {
      "version_metadata": {
        "binding": "WORKER_VERSION",
      },
      "r2_buckets": [
        {
          "binding": "HISTORY_FILES",
          "bucket_name": "boluo-history-files",
        },
      ],
      "vars": {
        "BACKEND_URL": "https://production.boluo.chat",
        "DEPLOYMENT_ENV": "production",
        "FRONTEND_APP": "legacy",
      },
    },
    "staging": {
      "version_metadata": {
        "binding": "WORKER_VERSION",
      },
      "r2_buckets": [
        {
          "binding": "HISTORY_FILES",
          "bucket_name": "boluo-history-files",
        },
      ],
      "vars": {
        "BACKEND_URL": "https://boluo-server-staging.fly.dev",
        "DEPLOYMENT_ENV": "staging",
        "FRONTEND_APP": "legacy",
      },
    },
  },
}
