{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    space AS \"space!: SpaceRecord\",\n    COALESCE(activity.latest_activity, space.created) AS \"latest_activity!\"\nFROM\n    spaces space\nLEFT JOIN space_activity activity ON activity.space_id = space.id\nWHERE\n    space.deleted = FALSE\n    AND concat(space.name, ' ', space.description)\n    LIKE ALL ($1)\nLIMIT 1024;\n",
