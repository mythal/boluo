  "db_name": "PostgreSQL",
  "query": "SELECT\n    space AS \"space!: SpaceRecord\",\n    COALESCE(activity.latest_activity, space.created) AS \"latest_activity!\"\nFROM\n    spaces space\nLEFT JOIN space_activity activity ON activity.space_id = space.id\nWHERE\n    space.owner_id = $1\n    AND space.deleted = FALSE;\n",
