  "query": "INSERT INTO entry_effects (\n    id,\n    space_id,\n    scope_id,\n    operator_id\n)\nSELECT\n    $1,\n    scope.space_id,\n    scope.id,\n    $3\nFROM scopes scope\nWHERE scope.id = $2\n  AND scope.space_id = $4\nRETURNING\n    id,\n    space_id,\n    scope_id,\n    operator_id,\n    created;\n",
