  "db_name": "PostgreSQL",
  "query": "SELECT\n    s AS \"space!: SpaceRecord\",\n    COALESCE(activity.latest_activity, s.created) AS \"latest_activity!\"\nFROM\n    channels ch\n    INNER JOIN spaces s ON ch.space_id = s.id\n    LEFT JOIN space_activity activity ON activity.space_id = s.id\nWHERE\n    ch.id = $1;\n",
