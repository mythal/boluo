  "db_name": "PostgreSQL",
  "query": "SELECT\n    msg AS \"message!: Message\"\nFROM\n    messages msg\nWHERE\n    msg.channel_id = $1\n    AND ($2::float8 IS NULL\n        OR msg.pos < $2) -- before\nORDER BY\n    msg.pos DESC\nLIMIT $3;\n\n",
